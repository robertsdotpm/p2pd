pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install --user pytest'
            }
        }

        stage('Run Test') {
            steps {
                sh 'python3 -m unittest tests/test_hello_world.py'
            }
        }
    }
}