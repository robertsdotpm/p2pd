pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install Dependencies') {
            steps {
                sh 'pip install pytest'
            }
        }

        stage('Run Test') {
            steps {
                sh 'pytest tests/test_hello_world.py'
            }
        }
    }
}